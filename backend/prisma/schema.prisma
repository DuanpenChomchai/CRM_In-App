// ===========================================================
// DATABASE & GENERATOR
// ===========================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===========================================================
// ENUMS
// ===========================================================

enum Role {
  CUSTOMER
  SALE
  MANAGER
  ADMIN
}

// ======= สำหรับการโทร =======
enum CallDirection {
  CUSTOMER_TO_SALE
  SALE_TO_CUSTOMER
}

enum CallStatus {
  RINGING
  ONGOING
  COMPLETED
  MISSED
  REJECTED
  CANCELED
}

// ======= Pipeline Stage หลัก (Single Source of Truth) =======
enum CustomerStatus {
  NEW
  CONTACTED
  NEGOTIATING
  QUOTATION
  CLOSED
}

// ======= ประเภทข้อความแชท =======
enum ChatMessageType {
  TEXT
  IMAGE
  FILE
}

// ======= สถานะใบเสนอราคา =======
enum QuotationStatus {
  DRAFT
  WAIT_APPROVAL
  SENT
  APPROVED
  REJECTED
}

// ======= Status รายละเอียดแต่ละ Stage =======
enum ContactedStatus {
  FOLLOWING_UP
  WAITING_REPLY
  APPOINTED
  NOT_INTERESTED
}

enum NegotiationStatus {
  NEGOTIATING
  WAITING_CONFIRM
  COUNTER_OFFER
  PAUSED
}

enum ClosedDealStatus {
  CLOSED
}

enum DealResult {
  WON
  LOST
}

// ===========================================================
// USER (ลูกค้า/เซลล์/ผู้จัดการ/แอดมิน)
// ===========================================================

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  tol      String  @unique
  img      String?
  role     Role    @default(CUSTOMER)

  managerId Int?
  manager   User?  @relation("UserManager", fields: [managerId], references: [id])
  team      User[] @relation("UserManager")

  customers      Customer[]       @relation("CustomerOwner")
  salesCustomers Customer[]       @relation("SaleCustomers")
  closedDeals    ClosedDeal[]
  communications Communications[]

  saleCalls     Call[] @relation("SaleCallUser")
  customerCalls Call[] @relation("CustomerCallUser")

  properties Property[]

  // ✅ Quotation ownership + approval relations
  createdQuotations  Quotation[] @relation("QuotationCreatedBy")
  approvedQuotations Quotation[] @relation("QuotationApprovedBy")

  // ✅ Refresh Tokens
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================================
// REFRESH TOKEN (สำหรับ JWT Refresh Token 30 วัน)
// ===========================================================

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ===========================================================
// PRODUCT (สำหรับ Proposal)
// ===========================================================

model Product {
  id       Int     @id @default(autoincrement())
  name     String
  price    Decimal @db.Decimal(12, 2)
  property String?
  img      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================================
// PROPERTY (อสังหาริมทรัพย์)
// ===========================================================

enum PropertyType {
  HOUSE
  CONDO
  TOWNHOME
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Property {
  id          Int            @id @default(autoincrement())
  name        String
  type        PropertyType
  location    String
  address     String?
  price       Decimal        @db.Decimal(12, 2)
  bedrooms    Int            @default(0)
  bathrooms   Int            @default(0)
  size        Int            @default(0)
  status      PropertyStatus @default(AVAILABLE)
  description String?
  img         String?

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  interestedCustomers Customer[] @relation("InterestedProperty")

  quotations     Quotation[]
  quotationItems QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([location])
  @@index([createdById])
}

// ===========================================================
// CUSTOMER
// ===========================================================

model Customer {
  id       Int     @id @default(autoincrement())
  name     String
  tol      String?
  email    String  @unique
  img      String?
  password String?

  productType String?
  priceBudget Decimal? @db.Decimal(12, 2)

  interestedPropertyId Int?
  interestedProperty   Property? @relation("InterestedProperty", fields: [interestedPropertyId], references: [id])

  userId Int?
  user   User? @relation("CustomerOwner", fields: [userId], references: [id])

  saleId Int?
  sale   User? @relation("SaleCustomers", fields: [saleId], references: [id])

  communications Communications[]

  contactedLogs Contacted[]

  quotations   Quotation[]
  negotiations Negotiation[]
  closedDeals  ClosedDeal[]

  calls        Call[]
  chatMessages ChatMessage[]

  mainStatus CustomerStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([saleId])
  @@index([mainStatus])
  @@index([createdAt])
  @@index([interestedPropertyId])
}

// ===========================================================
// COMMUNICATIONS
// ===========================================================

model Communications {
  id        Int     @id @default(autoincrement())
  phone     String?
  chat      String?
  voiceNote String?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  callId Int?
  call   Call? @relation(fields: [callId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([userId])
  @@index([callId])
}

// ===========================================================
// CONTACTED (เก็บเป็นประวัติ)
// ===========================================================

model Contacted {
  id        Int             @id @default(autoincrement())
  status    ContactedStatus
  topic     String?
  note      String?
  stateDate DateTime        @default(now())
  endDate   DateTime?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([stateDate])
  @@index([status])
}

// ===========================================================
// QUOTATION
// ===========================================================

model Quotation {
  id     Int             @id @default(autoincrement())
  status QuotationStatus @default(DRAFT)

  stateDate       DateTime  @default(now())
  terms           String?
  quotationNumber String    @unique
  totalAmount     Decimal   @db.Decimal(12, 2)
  note            String?
  endDate         DateTime?

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  items QuotationItem[]

  // ✅ ใครเป็นคนสร้าง
  createdById Int
  createdBy   User @relation("QuotationCreatedBy", fields: [createdById], references: [id])

  // ✅ ใครอนุมัติ
  approvedById Int?
  approvedBy   User?    @relation("QuotationApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([propertyId])
  @@index([stateDate])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
}

// ===========================================================
// QUOTATION ITEM
// ===========================================================

model QuotationItem {
  id Int @id @default(autoincrement())

  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  propertyId Int?
  property   Property? @relation(fields: [propertyId], references: [id])

  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(5, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId])
}

// ===========================================================
// NEGOTIATION (ประวัติการเจรจา)
// ===========================================================

model Negotiation {
  id        Int               @id @default(autoincrement())
  status    NegotiationStatus
  stateDate DateTime          @default(now())
  note      String?
  endDate   DateTime?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([stateDate])
  @@index([status])
}

// ===========================================================
// CLOSED DEAL
// ===========================================================

model ClosedDeal {
  id     Int              @id @default(autoincrement())
  status ClosedDealStatus @default(CLOSED)

  result DealResult

  stateDate   DateTime  @default(now())
  finalValue  Decimal?  @db.Decimal(12, 2)
  discount    Decimal?  @db.Decimal(12, 2)
  closingDate DateTime?
  note        String?
  endDate     DateTime?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([userId])
  @@index([closingDate])
  @@index([result])
}

// ===========================================================
// CALL (ประวัติการโทร)
// ===========================================================

model Call {
  id         Int       @id @default(autoincrement())
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  saleUserId Int?
  saleUser   User? @relation("SaleCallUser", fields: [saleUserId], references: [id])

  customerUserId Int?
  customerUser   User? @relation("CustomerCallUser", fields: [customerUserId], references: [id])

  direction CallDirection
  status    CallStatus

  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int?

  recordingKey         String?
  recordingDurationSec Int?
  transcript           String?
  note                 String?

  communications Communications[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([saleUserId])
  @@index([customerUserId])
  @@index([startedAt])
}

// ===========================================================
// CHAT MESSAGE
// ===========================================================

model ChatMessage {
  id         Int     @id @default(autoincrement())
  roomId     String
  text       String?

  senderName String
  cid        String?
  customerId Int?

  imgMessage  String?
  fileMessage String?

  type     ChatMessageType @default(TEXT)
  fileKey  String?
  fileName String?
  fileMime String?
  fileSize Int?

  createdAt DateTime @default(now())

  readByCustomerAt DateTime?
  readBySaleAt     DateTime?

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([roomId, createdAt])
  @@index([customerId, createdAt])

  // ✅ กันซ้ำ (cid เดียวกันจากคนเดิมในห้องเดียวกัน)
  @@unique([roomId, senderName, cid])
}
