// ===========================================================
// DATABASE & GENERATOR
// ===========================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===========================================================
// ENUMS
// ===========================================================

enum Role {
  CUSTOMER
  SALE
  MANAGER
  ADMIN
}

// ======= สำหรับการโทร =======
enum CallDirection {
  CUSTOMER_TO_SALE
  SALE_TO_CUSTOMER
}

enum CallStatus {
  RINGING
  ONGOING
  COMPLETED
  MISSED
  REJECTED
  CANCELED
}

// ======= สถานะลูกค้า (Stage หลัก) =======
enum CustomerStatus {
  NEW
  CONTACTED
  NEGOTIATING
  CLOSED
}

// ======= ประเภทข้อความแชท =======
enum ChatMessageType {
  TEXT
  IMAGE
  FILE
}


// ===========================================================
// USER (ลูกค้า/เซลล์/ผู้จัดการ/แอดมิน)
// ===========================================================

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  tol      String  @unique
  img      String?
  role     Role    @default(CUSTOMER)

  customers      Customer[]       @relation("CustomerOwner")
  salesCustomers Customer[]       @relation("SaleCustomers")
  closedDeals    ClosedDeal[]
  communications Communications[]

  saleCalls     Call[] @relation("SaleCallUser")
  customerCalls Call[] @relation("CustomerCallUser")

  // ✅ เพิ่ม: อสังหาฯที่ user คนนี้สร้าง (admin)
  properties Property[]

  // ✅ Refresh Tokens
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================================
// REFRESH TOKEN (สำหรับ JWT Refresh Token 30 วัน)
// ===========================================================

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ===========================================================
// PRODUCT (สำหรับ Proposal)
// ===========================================================

model Product {
  id       Int     @id @default(autoincrement())
  name     String
  price    Decimal @db.Decimal(12, 2)
  property String?
  img      String?

  proposals Proposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================================
// PROPERTY (อสังหาริมทรัพย์)
// ===========================================================

enum PropertyType {
  HOUSE
  CONDO
  TOWNHOME
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Property {
  id          Int            @id @default(autoincrement())
  name        String
  type        PropertyType
  location    String
  address     String?
  price       Decimal        @db.Decimal(12, 2)
  bedrooms    Int            @default(0)
  bathrooms   Int            @default(0)
  size        Int            @default(0) // ตร.ม.
  status      PropertyStatus @default(AVAILABLE)
  description String?
  img         String? // เช่น /api/properties/image/<key>

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([location])
  @@index([createdById])
}

// ===========================================================
// CUSTOMER
// ===========================================================

model Customer {
  id       Int     @id @default(autoincrement())
  name     String
  tol      String?
  email    String  @unique
  img      String?
  password String?

  productType String?
  priceBudget Decimal? @db.Decimal(12, 2)

  userId Int?
  user   User? @relation("CustomerOwner", fields: [userId], references: [id])

  saleId Int?
  sale   User? @relation("SaleCustomers", fields: [saleId], references: [id])

  communications Communications[]
  contacted      Contacted?
  quotations     Quotation[]
  negotiations   Negotiation[]
  closedDeals    ClosedDeal[]

  calls        Call[]
  chatMessages ChatMessage[]

  mainStatus CustomerStatus? @default(NEW)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId])
  @@index([saleId])
}

// ===========================================================
// COMMUNICATIONS
// ===========================================================

model Communications {
  id        Int     @id @default(autoincrement())
  phone     String?
  chat      String?
  voiceNote String?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  callId Int?
  call   Call? @relation(fields: [callId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([userId])
  @@index([callId])
}

// ===========================================================
// CONTACTED
// ===========================================================

model Contacted {
  id        Int       @id @default(autoincrement())
  status    String
  topic     String?
  note      String?
  stateDate DateTime  @default(now())
  endDate   DateTime?

  customerId Int      @unique
  customer   Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================================
// QUOTATION
// ===========================================================

model Quotation {
  id              Int       @id @default(autoincrement())
  status          String
  stateDate       DateTime  @default(now())
  terms           String?
  quotationNumber String    @unique
  totalAmount     Decimal   @db.Decimal(12, 2)
  note            String?
  endDate         DateTime?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  proposals Proposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([stateDate])
}

// ===========================================================
// PROPOSAL
// ===========================================================

model Proposal {
  id           Int     @id @default(autoincrement())
  quotation    String
  terms        String?
  priceOffered Decimal @db.Decimal(12, 2)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  quotationId Int
  quotationDb Quotation @relation(fields: [quotationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([quotationId])
}

// ===========================================================
// NEGOTIATION
// ===========================================================

model Negotiation {
  id        Int       @id @default(autoincrement())
  status    String
  stateDate DateTime  @default(now())
  note      String?
  endDate   DateTime?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([stateDate])
}

// ===========================================================
// CLOSED DEAL
// ===========================================================

model ClosedDeal {
  id          Int       @id @default(autoincrement())
  status      String
  stateDate   DateTime  @default(now())
  finalValue  Decimal?  @db.Decimal(12, 2)
  discount    Decimal?  @db.Decimal(12, 2)
  dealStatus  String?
  closingDate DateTime?
  note        String?
  endDate     DateTime?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([userId])
  @@index([closingDate])
}

// ===========================================================
// CALL (ประวัติการโทร)
// ===========================================================

model Call {
  id         Int       @id @default(autoincrement())
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  saleUserId Int?
  saleUser   User? @relation("SaleCallUser", fields: [saleUserId], references: [id])

  customerUserId Int?
  customerUser   User? @relation("CustomerCallUser", fields: [customerUserId], references: [id])

  direction CallDirection
  status    CallStatus

  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int?

  recordingKey         String?
  recordingDurationSec Int?
  transcript           String?
  note                 String?

  communications Communications[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([saleUserId])
  @@index([customerUserId])
  @@index([startedAt])
}

// ===========================================================
// CHAT MESSAGE (ประวัติการแชทจริง ๆ ของ WebSocket)
// ===========================================================

model ChatMessage {
  id         Int    @id @default(autoincrement())
  roomId     String
  text       String?

  senderName String
  cid        String?
  customerId Int?

  imgMessage  String?
  fileMessage String?

  type     ChatMessageType @default(TEXT)
  fileKey  String?
  fileName String?
  fileMime String?
  fileSize Int?

  createdAt DateTime @default(now())

  readByCustomerAt DateTime?
  readBySaleAt     DateTime?

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([roomId, createdAt])
  @@index([customerId, createdAt])

  // ✅ กันซ้ำ (cid เดียวกันจากคนเดิมในห้องเดียวกัน)
  @@unique([roomId, senderName, cid])
}