// ===========================================================
// DATABASE & GENERATOR
// ===========================================================
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===========================================================
// ENUMS
// ===========================================================
enum Role {
  CUSTOMER
  SALE
  MANAGER
  ADMIN
}

enum KpiStage {
  COMMUNICATIONS
  CONTACTED
  QUOTATION
  NEGOTIATION
  CLOSED_DEAL
}

enum KpiMetric {
  TIME_TO_FIRST_CONTACT
  TIME_IN_STAGE
  TIME_TO_QUOTATION
  TIME_TO_CLOSE
  RESPONSE_TIME
  CUSTOM
}

// ===========================================================
// USER (ลูกค้า/เซลล์/ผู้จัดการ/แอดมิน)
// ===========================================================
model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  tol      String  @unique
  img      String?
  role     Role    @default(CUSTOMER)

  // ลูกค้าที่ user นี้เป็นเจ้าของ (สมัครจากแอป)
  customers Customer[]              @relation("CustomerOwner")

  // ลูกค้าที่ user นี้เป็นเซลล์ดูแล
  salesCustomers Customer[]         @relation("SaleCustomers")

  // ความสัมพันธ์อื่น ๆ
  closedDeals    ClosedDeal[]
  communications Communications[]
  KPITracking    KPITracking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================================
// PRODUCT
// ===========================================================
model Product {
  id       Int      @id @default(autoincrement())
  name     String
  price    Decimal  @db.Decimal(12, 2)
  property String?
  img      String?

  proposals Proposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================================
// CUSTOMER (ตัวจริงของ CRM)
// ===========================================================
model Customer {
  id       Int     @id @default(autoincrement())
  name     String
  tol      String?
  email    String  @unique
  img      String?
  password String?

  // --- Preferred Product Info ---
  productType String?                     // ประเภทของสินค้า เช่น บ้านเดี่ยว คอนโด ฯลฯ
  priceBudget Decimal? @db.Decimal(12, 2) // งบประมาณ/ช่วงราคาที่สนใจ

  // --- Owner (User role=CUSTOMER) ---
  userId Int?
  user   User?      @relation("CustomerOwner", fields: [userId], references: [id])

  // --- Assigned Sale ---
  saleId Int?
  sale   User?      @relation("SaleCustomers", fields: [saleId], references: [id])

  // --- Related Stages ---
  communications Communications[]
  contacted      Contacted?
  quotations     Quotation[]
  negotiations   Negotiation[]
  closedDeals    ClosedDeal[]
  KPITracking    KPITracking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([saleId])
}

// ===========================================================
// COMMUNICATIONS (โทร/แชท/วอยซ์โน้ต)
// ===========================================================
model Communications {
  id        Int     @id @default(autoincrement())
  phone     String?
  chat      String?
  voiceNote String?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  userId Int?
  user   User?       @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([userId])
}

// ===========================================================
// CONTACTED (สเตจ CONTACTED)
// ===========================================================
model Contacted {
  id        Int      @id @default(autoincrement())
  status    String
  topic     String?
  note      String?
  stateDate DateTime @default(now())
  endDate   DateTime?

  customerId Int    @unique
  customer   Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================================
// QUOTATION (ใบเสนอราคา)
// ===========================================================
model Quotation {
  id              Int      @id @default(autoincrement())
  status          String
  stateDate       DateTime @default(now())
  terms           String?
  quotationNumber String   @unique
  totalAmount     Decimal  @db.Decimal(12, 2)
  note            String?
  endDate         DateTime?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  proposals  Proposal[]
  KPITracking KPITracking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([stateDate])
}

// ===========================================================
// PROPOSAL (รายการข้อเสนอ)
// ===========================================================
model Proposal {
  id           Int      @id @default(autoincrement())
  quotation    String
  terms        String?
  priceOffered Decimal   @db.Decimal(12, 2)

  productId   Int?
  product     Product?  @relation(fields: [productId], references: [id])

  quotationId Int
  quotationDb Quotation @relation(fields: [quotationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([quotationId])
}

// ===========================================================
// NEGOTIATION (ต่อรองราคา)
// ===========================================================
model Negotiation {
  id        Int      @id @default(autoincrement())
  status    String
  stateDate DateTime @default(now())
  note      String?
  endDate   DateTime?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  KPITracking KPITracking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([stateDate])
}

// ===========================================================
// CLOSED DEAL (ปิดดีล)
// ===========================================================
model ClosedDeal {
  id          Int      @id @default(autoincrement())
  status      String
  stateDate   DateTime @default(now())
  finalValue  Decimal? @db.Decimal(12, 2)
  discount    Decimal? @db.Decimal(12, 2)
  dealStatus  String?
  closingDate DateTime?
  note        String?
  endDate     DateTime?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  userId Int?
  user   User?       @relation(fields: [userId], references: [id])

  KPITracking KPITracking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([userId])
  @@index([closingDate])
}

// ===========================================================
// KPI TRACKING
// ===========================================================
model KPITracking {
  id Int @id @default(autoincrement())

  stage  KpiStage
  metric KpiMetric

  startedAt     DateTime
  endedAt       DateTime?
  valueSeconds  Int?
  targetSeconds Int?
  breached      Boolean @default(false)
  note          String?

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  quotationId Int?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  negotiationId Int?
  negotiation   Negotiation? @relation(fields: [negotiationId], references: [id])

  closedDealId Int?
  closedDeal   ClosedDeal? @relation(fields: [closedDealId], references: [id])

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([quotationId])
  @@index([negotiationId])
  @@index([closedDealId])
  @@index([userId])
  @@index([stage, metric])
  @@index([startedAt])
}
